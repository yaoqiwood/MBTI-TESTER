{
	"bsonType": "object",
	"required": ["person_id", "nickname", "name", "passcode", "review_status", "submitted_at", "updated_at"],
	"permission": {
		"read": true,
		"create": true,
		"update": true,
		"delete": true
	},
	"properties": {
		"_id": {
			"description": "文档 ID，系统自动生成"
		},
		"user_id": {
			"bsonType": "string",
			"title": "关联用户ID",
			"description": "关联 uni-id-users._id，用于绑定当前登录的小程序用户",
			"foreignKey": "uni-id-users._id",
			"trim": "both"
		},
		"wx_openid": {
			"bsonType": "string",
			"title": "微信 OpenID",
			"description": "微信小程序登录用户唯一标识",
			"trim": "both"
		},
		"wx_unionid": {
			"bsonType": "string",
			"title": "微信 UnionID",
			"description": "微信开放平台统一用户标识，存在时可用于跨应用识别",
			"trim": "both"
		},
		"wx_nickname": {
			"bsonType": "string",
			"title": "微信昵称",
			"description": "微信小程序登录后同步的昵称",
			"trim": "both"
		},
		"wx_avatar": {
			"bsonType": "string",
			"title": "微信头像",
			"description": "微信小程序登录后同步的头像地址",
			"trim": "both"
		},
		"wx_gender": {
			"bsonType": "int",
			"title": "微信性别",
			"description": "微信资料中的性别：0未知，1男，2女",
			"defaultValue": 0,
			"enum": [
				{
					"text": "未知",
					"value": 0
				},
				{
					"text": "男",
					"value": 1
				},
				{
					"text": "女",
					"value": 2
				}
			]
		},
		"wx_language": {
			"bsonType": "string",
			"title": "微信语言",
			"description": "微信资料中的语言",
			"trim": "both"
		},
		"wx_city": {
			"bsonType": "string",
			"title": "微信城市",
			"description": "微信资料中的城市",
			"trim": "both"
		},
		"wx_province": {
			"bsonType": "string",
			"title": "微信省份",
			"description": "微信资料中的省份",
			"trim": "both"
		},
		"wx_country": {
			"bsonType": "string",
			"title": "微信国家",
			"description": "微信资料中的国家",
			"trim": "both"
		},
		"person_id": {
			"bsonType": "int",
			"title": "唯一 ID",
			"description": "自增唯一编号"
		},
		"nickname": {
			"bsonType": "string",
			"title": "昵称",
			"trim": "both"
		},
		"name": {
			"bsonType": "string",
			"title": "姓名",
			"trim": "both"
		},
		"gender": {
			"bsonType": "string",
			"title": "性别",
			"trim": "both"
		},
		"age": {
			"bsonType": "int",
			"title": "年龄"
		},
		"personal_photo": {
			"bsonType": "string",
			"title": "个人照片",
			"description": "云存储 fileID 或可访问图片地址",
			"trim": "both"
		},
		"mobile": {
			"bsonType": "string",
			"title": "手机号",
			"trim": "both"
		},
		"passcode": {
			"bsonType": "string",
			"title": "口令",
			"description": "进入测试时用于验证的口令",
			"unique": true,
			"trim": "both"
		},
		"id_card": {
			"bsonType": "string",
			"title": "身份证号",
			"trim": "both"
		},
		"mbti": {
			"bsonType": "string",
			"title": "MBTI",
			"trim": "both"
		},
		"native_place": {
			"bsonType": "string",
			"title": "籍贯",
			"trim": "both"
		},
		"profession": {
			"bsonType": "string",
			"title": "职业",
			"trim": "both"
		},
		"address": {
			"bsonType": "string",
			"title": "住址",
			"trim": "both"
		},
		"family_overview": {
			"bsonType": "string",
			"title": "家庭概况",
			"trim": "both"
		},
		"church": {
			"bsonType": "string",
			"title": "所在教会",
			"trim": "both"
		},
		"referrer": {
			"bsonType": "string",
			"title": "推荐人",
			"trim": "both"
		},
		"self_introduction": {
			"bsonType": "string",
			"title": "自我介绍",
			"trim": "both"
		},
		"relationship_status": {
			"bsonType": "string",
			"title": "感情情况",
			"trim": "both"
		},
		"travel_mode": {
			"bsonType": "string",
			"title": "活动出行方式",
			"trim": "both"
		},
		"review_status": {
			"bsonType": "string",
			"title": "当前审核状态",
			"defaultValue": "pending",
			"enum": [
				{
					"text": "待审核",
					"value": "pending"
				},
				{
					"text": "已通过",
					"value": "approved"
				},
				{
					"text": "已驳回",
					"value": "rejected"
				}
			]
		},
		"reviewer": {
			"bsonType": "string",
			"title": "审核人",
			"trim": "both"
		},
		"remark": {
			"bsonType": "string",
			"title": "备注",
			"trim": "both"
		},
		"user_role": {
			"bsonType": "int",
			"title": "是否为用户",
			"defaultValue": 0,
			"enum": [
				{
					"text": "普通参与者",
					"value": 0
				},
				{
					"text": "同工",
					"value": 1
				},
				{
					"text": "用户",
					"value": 2
				},
				{
					"text": "高级用户",
					"value": 3
				}
			],
			"description": "0 为普通参与者-没有后台权限，1 为同工-可以进入后台查看，2 为用户-拥有可以进入后台增删人员，3 为高级用户-为开发者权限"
		},
		"private_message_quota": {
			"bsonType": "int",
			"title": "可发私信次数",
			"defaultValue": 0,
			"description": "用户当前可发起私信的次数"
		},
		"heart_message_quota": {
			"bsonType": "int",
			"title": "heart message quota",
			"defaultValue": 0,
			"description": "remaining heart-message send count"
		},
		"remaining_heart_value": {
			"bsonType": "int",
			"title": "remaining heart value",
			"defaultValue": 1,
			"description": "remaining heart value count"
		},
		"is_deleted": {
			"bsonType": "bool",
			"title": "是否删除",
			"defaultValue": false,
			"description": "逻辑删除标记，true 表示已删除"
		},
		"submitted_at": {
			"bsonType": "timestamp",
			"title": "提交时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"updated_at": {
			"bsonType": "timestamp",
			"title": "修改时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		}
	}
}
